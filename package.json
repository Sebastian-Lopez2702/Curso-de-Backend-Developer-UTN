{
  "name": "MercadoNexus API",
  "version": "1.0.0",
  "description": "RESTful API E-Commerce con Arquitectura Limpia, Node.js, Express, TypeScript y MongoDB",
  "main": "dist/server.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node dist/server.js",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:unit": "jest tests/models tests/services tests/middleware",
    "test:integration": "jest tests/routes tests/repositories tests/config tests/health.test.ts --runInBand",
    "test:detect": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "jest-docblock": "^30.5.0",
    "jest-junit": "^17.0.0",
    "jest-runner": "^30.5.2",
    "jest-runner-groups": "^2.2.0",
    "nodemon": "^1.14.10",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-jest-mocker": "^1.3.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
